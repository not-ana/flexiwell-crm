{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "ts-node --esm scripts/seed.ts",
    "seed:onboarding": "ts-node --esm scripts/seed.ts --profile=onboarding",
    "seed:admin-ready": "ts-node --esm scripts/seed.ts --profile=admin-ready",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "audit": "npm audit --omit=dev",
    "audit:fix": "npm audit fix --omit=dev"
  },
  "dependencies": {
    "@stripe/stripe-js": "^8.6.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.562.0",
    "mongodb": "^7.3.0",
    "next": "16.2.9",
    "openai": "^6.44.0",
    "papaparse": "^5.5.4",
    "posthog-js": "^1.392.0",
    "react": "19.2.7",
    "react-big-calendar": "^1.20.0",
    "react-dom": "19.2.7",
    "recharts": "^3.8.1",
    "resend": "^6.14.0",
    "stripe": "^20.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "happy-dom": "^20.10.6",
    "jsdom": "^27.4.0",
    "playwright": "^1.57.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3",
    "vitest": "^4.1.9"
  }
